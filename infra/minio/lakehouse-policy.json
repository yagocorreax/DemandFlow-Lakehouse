{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LakehouseBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::demandflow-raw",
        "arn:aws:s3:::demandflow-bronze",
        "arn:aws:s3:::demandflow-silver",
        "arn:aws:s3:::demandflow-gold",
        "arn:aws:s3:::demandflow-quarantine",
        "arn:aws:s3:::demandflow-checkpoints"
      ]
    },
    {
      "Sid": "LakehouseObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::demandflow-raw/*",
        "arn:aws:s3:::demandflow-bronze/*",
        "arn:aws:s3:::demandflow-silver/*",
        "arn:aws:s3:::demandflow-gold/*",
        "arn:aws:s3:::demandflow-quarantine/*",
        "arn:aws:s3:::demandflow-checkpoints/*"
      ]
    }
  ]
}
